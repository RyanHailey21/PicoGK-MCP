<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>picogk-mcp</ToolCommandName>
    <PackageId>PicoGK.Mcp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ryan Hailey, PicoGK Community</Authors>
    <Description>Model Context Protocol (MCP) server for PicoGK computational geometry and ShapeKernel</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RyanHailey21/PicoGK-MCP</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="PicoGK" Version="2.3.0" />
  </ItemGroup>

</Project>
